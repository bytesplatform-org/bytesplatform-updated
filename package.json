{
  "name": "bytesplatform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:site": "NEXT_PUBLIC_BYTESGOV_DEMO_URL=http://localhost:3001 NEXT_PUBLIC_BYTESBILLING_DEMO_URL=http://localhost:3002 next dev",
    "dev:gov": "next dev demos/bytesgov --port 3001",
    "dev:billing": "next dev demos/bytesbilling --port 3002",
    "dev:all": "concurrently --kill-others-on-fail --names site,bytesgov,bytesbilling --prefix-colors blue,green,magenta \"npm:dev:site\" \"npm:dev:gov\" \"npm:dev:billing\"",
    "prebuild": "npm run sitemap:check",
    "build": "next build",
    "build:demos": "next build demos/bytesgov && next build demos/bytesbilling",
    "start": "next start",
    "sitemap:dates": "node scripts/page-dates.mjs",
    "sitemap:check": "node scripts/page-dates.mjs --check",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
